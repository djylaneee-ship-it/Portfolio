{
  "name": "roblox-shorts-studio",
  "productName": "Roblox Shorts Studio",
  "version": "0.1.3",
  "description": "Génère des Shorts Roblox creepypasta (Groq + ElevenLabs + FFmpeg) à partir de tes enregistrements de gameplay et les publie tout seul sur YouTube selon un planning.",
  "author": "Rovex",
  "main": "electron.js",
  "scripts": {
    "app": "electron .",
    "start": "node server.js",
    "check": "node tools/check.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "electron-updater": "6.8.10",
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "googleapis": "144.0.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.rovex.shortsstudio",
    "productName": "Roblox Shorts Studio",
    "asar": false,
    "directories": { "output": "dist" },
    "files": [
      "*.js", "shorts.ico", "icon.png", "CLAUDE.md", "src/**", "public/**",
      "!node_modules/ffprobe-static/bin/darwin/**", "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "shorts.ico",
      "artifactName": "Roblox-Shorts-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Roblox Shorts Studio",
      "runAfterFinish": true,
      "installerIcon": "shorts.ico",
      "uninstallerIcon": "shorts.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [{ "provider": "generic", "url": "https://github.com/djylaneee-ship-it/Portfolio/releases/download/shorts-studio" }]
  }
}
