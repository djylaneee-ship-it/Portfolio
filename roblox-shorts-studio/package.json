{
  "name": "roblox-shorts-studio",
  "productName": "Roblox Shorts Studio",
  "version": "0.1.0",
  "description": "Génère des Shorts Roblox creepypasta (Groq + ElevenLabs + FFmpeg) à partir de tes enregistrements de gameplay et les publie tout seul sur YouTube selon un planning.",
  "main": "electron.js",
  "scripts": {
    "app": "electron .",
    "start": "node server.js",
    "check": "for f in *.js src/*.js src/*/*.js public/*.js; do node --check $f || exit 1; done",
    "dist": "electron-builder --win nsis --publish never"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0",
    "googleapis": "144.0.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.rovex.shortsstudio",
    "productName": "Roblox Shorts Studio",
    "asar": false,
    "directories": { "output": "dist" },
    "files": ["*.js", "src/**", "public/**"],
    "win": { "target": "nsis" }
  }
}
